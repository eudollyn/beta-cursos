# Beta Cursos — desenvolvimento local
# Copie para .env e nunca versione credenciais reais.

APP_ENV=local
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
ALLOWED_ORIGINS=http://127.0.0.1:3000

# SQLite local sem dependências externas. Para testar com PostgreSQL local,
# substitua por uma URL postgresql://. No Railway, use:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=sqlite:.data/beta-cursos.sqlite

# Exclusivo para desenvolvimento local. Gere outro segredo para staging/produção.
SESSION_SECRET=local-only-change-this-secret-before-hosting
SESSION_COOKIE_NAME=beta_session
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_IP_MAX=30
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Identidade por e-mail. Em desenvolvimento, preview devolve o link apenas
# para a interface local. Nunca use preview em um ambiente hospedado.
EMAIL_DRIVER=preview
EMAIL_VERIFICATION_REQUIRED=true
PASSWORD_RESET_ENABLED=true
EMAIL_FROM=Beta Cursos <no-reply@beta.local>
EMAIL_REPLY_TO=
EMAIL_TOKEN_SECRET=local-email-token-secret-change-before-hosting
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_TIMEOUT_MS=10000

# Produção com Resend:
# EMAIL_DRIVER=resend
# EMAIL_FROM=Beta Cursos <cursos@seudominio.com.br>
# EMAIL_REPLY_TO=contato@seudominio.com.br
# RESEND_API_KEY=re_...

# Desenvolvimento local sem credenciais externas.
STORAGE_DRIVER=filesystem
LOCAL_STORAGE_PATH=.data/media
STORAGE_PREFIX=
STORAGE_MAX_MB=0

# Implantação gratuita no Railway (um serviço + volume persistente).
# O Railway fornece RAILWAY_VOLUME_MOUNT_PATH automaticamente quando o
# volume é anexado. Não defina DATABASE_URL nem LOCAL_STORAGE_PATH neste modo:
# ambos são resolvidos com segurança dentro do volume.
# APP_ENV=production
# RAILWAY_FREE_VOLUME_MODE=true
# STORAGE_DRIVER=filesystem
# STORAGE_MAX_MB=400
# PDF_MAX_MB=15
# IMAGE_MAX_MB=5
# VIDEO_MAX_MB=25

# Railway Bucket — configure como referências no painel:
# BUCKET=${{Media.BUCKET}}
# ENDPOINT=${{Media.ENDPOINT}}
# REGION=${{Media.REGION}}
# ACCESS_KEY_ID=${{Media.ACCESS_KEY_ID}}
# SECRET_ACCESS_KEY=${{Media.SECRET_ACCESS_KEY}}

# Aliases também aceitos para Railway, AWS S3, MinIO e serviços compatíveis:
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=
#
# AWS_S3_BUCKET=
# AWS_S3_ENDPOINT=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_S3_FORCE_PATH_STYLE=false

BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_ADMIN_EMAILS=
REGISTRATION_ENABLED=true
ENABLE_DEMO_LOGIN=false
DEMO_ROLE=student
# Modos disponíveis:
# disabled   = pagamentos desligados
# test       = ambiente de homologação, usando a conta vendedora e usuários de teste do Mercado Pago
# production = credenciais definitivas do Mercado Pago
CHECKOUT_MODE=disabled

# Nunca coloque credenciais reais no GitHub.
# Estes valores devem ser cadastrados nas variáveis do Railway.
MERCADO_PAGO_ACCESS_TOKEN_TEST=
MERCADO_PAGO_ACCESS_TOKEN_PROD=
# No sandbox, o Mercado Pago exige um e-mail terminado em @testuser.com.
MERCADO_PAGO_TEST_PAYER_EMAIL=test@testuser.com

# Assinaturas secretas geradas em:
# Mercado Pago > Suas integrações > Webhooks > Configurar notificações.
# Cadastre /api/webhooks/mercado-pago e habilite o evento "Order (Mercado Pago)".
MERCADO_PAGO_WEBHOOK_SECRET_TEST=
MERCADO_PAGO_WEBHOOK_SECRET_PROD=

# Tempo máximo das chamadas à API do Mercado Pago.
MERCADO_PAGO_TIMEOUT_MS=10000
LOG_LEVEL=debug
HEALTHCHECK_TIMEOUT_MS=3000
PDF_MAX_MB=30
IMAGE_MAX_MB=10
VIDEO_MAX_MB=100
